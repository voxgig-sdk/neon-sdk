# Entity: organization_invitation

main: kit: entity: organization_invitation: {

  alias: field: {}

  fields: {
    email: {
      fo: "email"
      h: "Email"
      n: "email"
      r: true
      sh: "Email of the invited user"
      t: "`$STRING`"
    }
    id: {
      fo: "uuid"
      h: "Id"
      n: "id"
      r: true
      sh: "The invitation ID."
      t: "`$STRING`"
    }
    invitations: {
      h: "Invitations"
      n: "invitations"
      r: true
      sh: "List of pending invitations for the organization."
      t: "`$ARRAY`"
    }
    invited_at: {
      fo: "date-time"
      h: "Invited At"
      n: "invited_at"
      r: true
      sh: "Timestamp when the invitation was created"
      t: "`$STRING`"
    }
    invited_by: {
      fo: "uuid"
      h: "Invited By"
      n: "invited_by"
      r: true
      sh: "UUID for the user_id who extended the invitation"
      t: "`$STRING`"
    }
    org_id: {
      h: "Org Id"
      n: "org_id"
      r: true
      sh: "Organization id as it is stored in Neon"
      t: "`$STRING`"
    }
    role: {
      h: "Role"
      n: "role"
      r: true
      sh: "Organization member's role."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "organization_invitation"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /organizations/{org_id}/invitations"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "org_id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/organizations/{org_id}/invitations"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              org_id: "id"
            }
          }
          s: [
            {
              lit: "organizations"
            }
            {
              var: "id"
            }
            {
              lit: "invitations"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /organizations/{org_id}/invitations"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "org_id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/organizations/{org_id}/invitations"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              org_id: "id"
            }
          }
          s: [
            {
              lit: "organizations"
            }
            {
              var: "id"
            }
            {
              lit: "invitations"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.invitations`"
          }
        }
      ]
    }
  }



}
