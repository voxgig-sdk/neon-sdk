              }
            ]
          }
          m: "POST"
          o: "/projects/{project_id}/branches"
          q: {
            exist: [
              "project_id"
            ]
          }
          s: [
            {
              lit: "projects"
            }
            {
              var: "project_id"
            }
            {
              lit: "branches"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.branch`"
          }
        }
      ]
    }
