# Entity: neon_auth_webhook_config

main: kit: entity: neon_auth_webhook_config: {

  alias: field: {}

  fields: {
    enabled: {
      h: "Enabled"
      n: "enabled"
      r: true
      sh: "Whether the webhook is active."
      t: "`$BOOLEAN`"
    }
    enabled_events: {
      h: "Enabled Events"
      n: "enabled_events"
      r: false
      sh: "Event types that trigger this webhook."
      t: "`$ARRAY`"
    }
    timeout_seconds: {
      h: "Timeout Seconds"
      n: "timeout_seconds"
      r: false
      sh: "Maximum time, in seconds, to wait for a response from the webhook endpoint."
      t: "`$INTEGER`"
    }
    webhook_url: {
      h: "Webhook Url"
      n: "webhook_url"
      r: false
      sh: "Destination URL that receives webhook event payloads."
      t: "`$STRING`"
    }
  }

  name: "neon_auth_webhook_config"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /projects/{project_id}/branches/{branch_id}/auth/webhooks"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "branch_id"
                or: "branch_id"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "project_id"
                or: "project_id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/projects/{project_id}/branches/{branch_id}/auth/webhooks"
          q: {
            exist: [
              "branch_id"
              "project_id"
            ]
          }
          s: [
            {
              lit: "projects"
            }
            {
              var: "project_id"
            }
            {
              lit: "branches"
            }
            {
              var: "branch_id"
            }
            {
              lit: "auth"
            }
            {
              lit: "webhooks"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.enabled_events`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          co: {
            id: "PUT /projects/{project_id}/branches/{branch_id}/auth/webhooks"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "branch_id"
                or: "branch_id"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "project_id"
                or: "project_id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "PUT"
          o: "/projects/{project_id}/branches/{branch_id}/auth/webhooks"
          q: {
            exist: [
              "branch_id"
              "project_id"
            ]
          }
          s: [
            {
              lit: "projects"
            }
            {
              var: "project_id"
            }
            {
              lit: "branches"
            }
            {
              var: "branch_id"
            }
            {
              lit: "auth"
            }
            {
              lit: "webhooks"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }


  relations: ancestors: [
    [path("$.main.kit.entity.project") path("$.main.kit.entity.branch")]
  ]

}
