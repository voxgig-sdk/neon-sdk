# Entity: database

main: kit: entity: database: {

  alias: field: {}

  fields: {
    branch_id: {
      h: "Branch Id"
      n: "branch_id"
      r: true
      sh: "The ID of the branch this database belongs to."
      t: "`$STRING`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: true
      sh: "A timestamp indicating when the database was created"
      t: "`$STRING`"
    }
    database: {
      h: "Database"
      n: "database"
      r: true
      sh: "Configuration for the new Postgres database."
      t: "`$OBJECT`"
    }
    id: {
      fo: "int64"
      h: "Id"
      n: "id"
      r: true
      sh: "The database ID"
      t: "`$INTEGER`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The database name"
      t: "`$STRING`"
    }
    owner_name: {
      h: "Owner Name"
      n: "owner_name"
      r: true
      sh: "The name of role that owns the database"
      t: "`$STRING`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: true
      sh: "A timestamp indicating when the database was last updated"
      t: "`$STRING`"
    }
  }

