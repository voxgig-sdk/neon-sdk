      name: "create"
      points: [
        {
          co: {
            id: "POST /projects/{project_id}/branches/{branch_id}/databases"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "branch_id"
                or: "branch_id"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "project_id"
                or: "project_id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/projects/{project_id}/branches/{branch_id}/databases"
          q: {
            exist: [
              "branch_id"
              "project_id"
            ]
          }
          s: [
            {
              lit: "projects"
            }
            {
              var: "project_id"
            }
            {
              lit: "branches"
            }
            {
              var: "branch_id"
            }
            {
              lit: "databases"
            }
          ]
          t: {
            req: {
              database: "`reqdata`"
            }
            res: "`body.database`"
          }
        }
      ]
    }
