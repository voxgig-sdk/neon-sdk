# Entity: neon_auth_integration

main: kit: entity: neon_auth_integration: {

  alias: field: {}

  fields: {
    auth_provider: {
      h: "Auth Provider"
      n: "auth_provider"
      r: true
      sh: "Authentication provider integrated with this Neon Auth configuration."
      t: "`$STRING`"
    }
    auth_provider_project_id: {
      h: "Auth Provider Project Id"
      n: "auth_provider_project_id"
      r: true
      sh: "Project identifier assigned by the auth provider for this integration."
      t: "`$STRING`"
    }
    base_url: {
      h: "Base Url"
      n: "base_url"
      r: false
      sh: "Base URL of the Neon Auth service endpoint for this integration."
      t: "`$STRING`"
    }
    branch_id: {
      h: "Branch Id"
      n: "branch_id"
      r: true
      sh: "The Neon branch ID."
      t: "`$STRING`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: true
      sh: "Timestamp when the Neon Auth integration was created, in RFC 3339 format (UTC)."
      t: "`$STRING`"
    }
    db_name: {
      h: "Db Name"
      n: "db_name"
      r: true
      sh: "Name of the database used by the Neon Auth integration."
      t: "`$STRING`"
    }
    jwks_url: {
      h: "Jwks Url"
      n: "jwks_url"
      r: true
      sh: "URL of the provider's JWKS endpoint used to verify JWTs."
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "Application name shown in auth emails and communications."
      t: "`$STRING`"
    }
    owned_by: {
      h: "Owned By"
      n: "owned_by"
      r: true
      sh: "Owner of the auth provider project."
      t: "`$STRING`"
    }
    transfer_status: {
      h: "Transfer Status"
      n: "transfer_status"
      r: false
      sh: "Ownership transfer state for the auth provider project."
      t: "`$STRING`"
    }
  }

  name: "neon_auth_integration"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /projects/{project_id}/auth/integrations"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "project_id"
                or: "project_id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/projects/{project_id}/auth/integrations"
          q: {
            exist: [
              "project_id"
            ]
          }
          s: [
            {
              lit: "projects"
            }
            {
              var: "project_id"
            }
            {
              lit: "auth"
            }
            {
              lit: "integrations"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /projects/{project_id}/branches/{branch_id}/auth"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "branch_id"
                or: "branch_id"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "project_id"
                or: "project_id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/projects/{project_id}/branches/{branch_id}/auth"
          q: {
            exist: [
              "branch_id"
              "project_id"
            ]
          }
          s: [
            {
              lit: "projects"
            }
            {
              var: "project_id"
            }
            {
              lit: "branches"
            }
            {
              var: "branch_id"
            }
            {
              lit: "auth"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }


  relations: ancestors: [
    [path("$.main.kit.entity.project")]
    [path("$.main.kit.entity.project") path("$.main.kit.entity.branch")]
  ]

}
