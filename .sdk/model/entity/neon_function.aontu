# Entity: neon_function

main: kit: entity: neon_function: {

  alias: field: {}

  fields: {
    active_deployment: {
      h: "Active Deployment"
      n: "active_deployment"
      r: false
      sh: "The most recent deployment whose build completed successfully."
      t: "`$ANY`"
    }
    created_at: {
      h: "Created At"
      n: "created_at"
      r: true
      t: "`$STRING`"
    }
    current_deployment: {
      h: "Current Deployment"
      n: "current_deployment"
      r: false
      sh: "The most recent deployment, regardless of build status."
      t: "`$ANY`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "Opaque, stable function identifier."
      t: "`$STRING`"
    }
    invocation_url: {
      h: "Invocation Url"
      n: "invocation_url"
      r: true
      sh: "URL at which the function is invoked."
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "Free-form display name."
      t: "`$STRING`"
    }
    slug: {
      h: "Slug"
      n: "slug"
      r: true
      sh: "Branch-unique, lowercase DNS-label."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "neon_function"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /projects/{project_id}/branches/{branch_id}/functions/{slug}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "branch_id"
                or: "branch_id"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "id"
                or: "slug"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "project_id"
                or: "project_id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/projects/{project_id}/branches/{branch_id}/functions/{slug}"
          q: {
            exist: [
              "branch_id"
              "id"
              "project_id"
            ]
          }
          r: {
            param: {
              slug: "id"
            }
          }
          s: [
            {
              lit: "projects"
            }
            {
              var: "project_id"
            }
            {
              lit: "branches"
            }
            {
              var: "branch_id"
            }
            {
              lit: "functions"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.function`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          co: {
            id: "PATCH /projects/{project_id}/branches/{branch_id}/functions/{slug}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "branch_id"
                or: "branch_id"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "id"
                or: "slug"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "project_id"
                or: "project_id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "PATCH"
          o: "/projects/{project_id}/branches/{branch_id}/functions/{slug}"
          q: {
            exist: [
              "branch_id"
              "id"
              "project_id"
            ]
          }
          r: {
            param: {
              slug: "id"
            }
          }
          s: [
            {
              lit: "projects"
            }
            {
              var: "project_id"
            }
            {
              lit: "branches"
            }
            {
              var: "branch_id"
            }
            {
              lit: "functions"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.function`"
          }
        }
      ]
    }
  }


  relations: ancestors: [
    [path("$.main.kit.entity.project") path("$.main.kit.entity.branch")]
  ]

}
