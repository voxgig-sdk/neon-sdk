              "from"
              "granularity"
              "limit"
              "metric"
              "org_id"
              "project_id"
              "to"
            ]
          }
          s: [
            {
              lit: "consumption_history"
            }
            {
              lit: "v2"
            }
            {
              lit: "branches"
            }
          ]
          t: {
