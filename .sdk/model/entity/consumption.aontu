# Entity: consumption

main: kit: entity: consumption: {

  alias: field: {}

  fields: {
    branch_id: {
      h: "Branch Id"
      n: "branch_id"
      r: true
      sh: "The Neon branch ID."
      t: "`$STRING`"
    }
    periods: {
      h: "Periods"
      n: "periods"
      r: true
      sh: "Consumption history records for the branch, grouped by billing period."
      t: "`$ARRAY`"
    }
    project_id: {
      h: "Project Id"
      n: "project_id"
      r: true
