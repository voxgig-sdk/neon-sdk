# Entity: project_branch_log_field

main: kit: entity: project_branch_log_field: {

  alias: field: {}

  fields: {
    fields: {
      h: "Fields"
      n: "fields"
      r: true
      sh: "Log field names observed on this branch, each usable as `field_name` on the log field-values endpoint."
      t: "`$ARRAY`"
    }
  }

  name: "project_branch_log_field"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /projects/{project_id}/branches/{branch_id}/logs/fields"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "branch_id"
                or: "branch_id"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "project_id"
                or: "project_id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/projects/{project_id}/branches/{branch_id}/logs/fields"
          q: {
            exist: [
              "branch_id"
              "project_id"
            ]
          }
          s: [
            {
              lit: "projects"
            }
            {
              var: "project_id"
            }
            {
              lit: "branches"
            }
            {
              var: "branch_id"
            }
            {
              lit: "logs"
            }
            {
              lit: "fields"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.fields`"
          }
        }
      ]
    }
  }


  relations: ancestors: [
    [path("$.main.kit.entity.project") path("$.main.kit.entity.branch")]
  ]

}
