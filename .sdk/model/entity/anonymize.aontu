              }
            ]
          }
          m: "POST"
          o: "/projects/{project_id}/branches/{branch_id}/anonymize"
          q: {
            exist: [
              "branch_id"
              "project_id"
            ]
          }
          s: [
            {
              lit: "projects"
            }
            {
              var: "project_id"
            }
            {
              lit: "branches"
            }
            {
              var: "branch_id"
            }
            {
