# Entity: anonymize

main: kit: entity: anonymize: {

  alias: field: {}

  fields: {
    branch_id: {
      h: "Branch Id"
      n: "branch_id"
      r: true
      sh: "The ID of the anonymized branch."
      t: "`$STRING`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: true
      sh: "A timestamp indicating when the anonymized branch was created"
      t: "`$STRING`"
    }
    failed_at: {
      fo: "date-time"
      h: "Failed At"
      n: "failed_at"
      r: false
      sh: "A timestamp indicating when the anonymized branch operation failed (if applicable)"
      t: "`$STRING`"
    }
    last_run: {
      h: "Last Run"
      n: "last_run"
      r: false
      sh: "Metadata about the most recent anonymization attempt for the branch."
      t: "`$OBJECT`"
    }
    project_id: {
      h: "Project Id"
      n: "project_id"
      r: true
      sh: "The ID of the project this branch belongs to."
      t: "`$STRING`"
    }
    state: {
      h: "State"
      n: "state"
      r: true
      sh: "The current state of the anonymized branch."
      t: "`$STRING`"
    }
    status_message: {
      h: "Status Message"
      n: "status_message"
      r: false
      sh: "A descriptive message about the current status or any errors"
      t: "`$STRING`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: true
      sh: "A timestamp indicating when the anonymized branch status was last updated"
      t: "`$STRING`"
    }
  }

  name: "anonymize"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /projects/{project_id}/branches/{branch_id}/anonymize"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "branch_id"
                or: "branch_id"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "project_id"
                or: "project_id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/projects/{project_id}/branches/{branch_id}/anonymize"
          q: {
            exist: [
              "branch_id"
              "project_id"
            ]
          }
          s: [
            {
              lit: "projects"
            }
            {
              var: "project_id"
            }
            {
              lit: "branches"
            }
            {
              var: "branch_id"
            }
            {
              lit: "anonymize"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }


  relations: ancestors: [
    [path("$.main.kit.entity.project") path("$.main.kit.entity.branch")]
  ]

}
