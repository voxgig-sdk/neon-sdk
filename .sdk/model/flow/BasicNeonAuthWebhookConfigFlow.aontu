# BasicNeonAuthWebhookConfigFlow

main: kit: flow: BasicNeonAuthWebhookConfigFlow:
{
  entity: "neon_auth_webhook_config",
  kind: "basic",
  name: "BasicNeonAuthWebhookConfigFlow",
  step: [
    {
      m: {
        branch_id: "branch01",
        project_id: "project01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "neon_auth_webhook_config_ref01"
          }
        }
      ]
    }

    {
      d: {
        project_id: "project01"
      }

      i: {
        ref: "neon_auth_webhook_config_ref01",
        srcdatavar: "neon_auth_webhook_config_ref01_data",
        suffix: "_up0",
        textfield: "webhook_url"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-neon_auth_webhook_config_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicNeonAuthWebhookConfigFlow"
}