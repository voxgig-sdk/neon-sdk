      m: {
        id: "branch_ai_gateway01",
        project_id: "project01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-branch_ai_gateway_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicBranchAiGatewayFlow"
}