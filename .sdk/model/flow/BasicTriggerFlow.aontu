# BasicTriggerFlow

main: kit: flow: BasicTriggerFlow:
{
  entity: "trigger",
  kind: "basic",
  name: "BasicTriggerFlow",
  step: [
    {
      i: {
        ref: "trigger_ref01"
      }

      m: {
        branch_id: "branch01",
        project_id: "project01"
      }

      o: "create"
    }

    {
      m: {
        branch_id: "branch01",
        project_id: "project01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "trigger_ref01"
          }
        }
      ]
    }

    {
      d: {
        branch_id: "branch01",
        project_id: "project01"
      }

      i: {
        ref: "trigger_ref01",
        srcdatavar: "trigger_ref01_data",
        suffix: "_up0"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-trigger_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "trigger_ref01",
        srcdatavar: "trigger_ref01_data",
        suffix: "_dt0"
      }

      m: {
        branch_id: "branch01",
        id: "trigger01",
        project_id: "project01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-trigger_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicTriggerFlow"
}