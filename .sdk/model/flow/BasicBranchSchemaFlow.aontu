# BasicBranchSchemaFlow

main: kit: flow: BasicBranchSchemaFlow:
{
  entity: "branch_schema",
  kind: "basic",
  name: "BasicBranchSchemaFlow",
  step: [
    {
      i: {
        ref: "branch_schema_ref01",
        srcdatavar: "branch_schema_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "branch_schema01",
        project_id: "project01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-branch_schema_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicBranchSchemaFlow"
}