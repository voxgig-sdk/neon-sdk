# BasicBranchFlow

main: kit: flow: BasicBranchFlow:
{
  entity: "branch",
  kind: "basic",
  name: "BasicBranchFlow",
  step: [
    {
      i: {
        ref: "branch_ref01"
      }

      m: {
        project_id: "project01"
      }

      o: "create"
    }

    {
      m: {
        project_id: "project01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "branch_ref01"
          }
        }
      ]
    }

    {
      d: {
        project_id: "project01"
      }

      i: {
        ref: "branch_ref01",
        srcdatavar: "branch_ref01_data",
        suffix: "_up0",
        textfield: "created_at"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-branch_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "branch_ref01",
        srcdatavar: "branch_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "branch01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-branch_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "branch_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "branch01",
        project_id: "project01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        project_id: "project01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "branch_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicBranchFlow"
}