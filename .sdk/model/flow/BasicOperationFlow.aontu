# BasicOperationFlow

main: kit: flow: BasicOperationFlow:
{
  entity: "operation",
  kind: "basic",
  name: "BasicOperationFlow",
  step: [
    {
      i: {
        ref: "operation_ref01"
      }

      m: {
        branch_id: "branch01",
        project_id: "project01"
      }

      o: "create"
    }

    {
      m: {
        project_id: "project01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "operation_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "operation_ref01",
        srcdatavar: "operation_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "operation01",
        project_id: "project01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-operation_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicOperationFlow"
}