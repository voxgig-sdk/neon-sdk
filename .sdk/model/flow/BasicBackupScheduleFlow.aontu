# BasicBackupScheduleFlow

main: kit: flow: BasicBackupScheduleFlow:
{
  entity: "backup_schedule",
  kind: "basic",
  name: "BasicBackupScheduleFlow",
  step: [
    {
      m: {
        branch_id: "branch01",
        project_id: "project01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "backup_schedule_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicBackupScheduleFlow"
}