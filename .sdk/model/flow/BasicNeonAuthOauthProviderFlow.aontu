# BasicNeonAuthOauthProviderFlow

main: kit: flow: BasicNeonAuthOauthProviderFlow:
{
  entity: "neon_auth_oauth_provider",
  kind: "basic",
  name: "BasicNeonAuthOauthProviderFlow",
  step: [
    {
      i: {
        ref: "neon_auth_oauth_provider_ref01"
      }

      m: {
        branch_id: "branch01",
        project_id: "project01"
      }

      o: "create"
    }

    {
      m: {
        project_id: "project01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "neon_auth_oauth_provider_ref01"
          }
        }
      ]
    }

    {
      d: {
        project_id: "project01"
      }

      i: {
        ref: "neon_auth_oauth_provider_ref01",
        srcdatavar: "neon_auth_oauth_provider_ref01_data",
        suffix: "_up0",
        textfield: "client_id"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-neon_auth_oauth_provider_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicNeonAuthOauthProviderFlow"
}