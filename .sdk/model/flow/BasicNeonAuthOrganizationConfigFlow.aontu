# BasicNeonAuthOrganizationConfigFlow

main: kit: flow: BasicNeonAuthOrganizationConfigFlow:
{
  entity: "neon_auth_organization_config",
  kind: "basic",
  name: "BasicNeonAuthOrganizationConfigFlow",
  step: [
    {
      d: {
        project_id: "project01"
      }

      i: {
        ref: "neon_auth_organization_config_ref01",
        srcdatavar: "neon_auth_organization_config_ref01_data",
        suffix: "_up0",
        textfield: "creator_role"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-neon_auth_organization_config_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicNeonAuthOrganizationConfigFlow"
}